# ─── Ingram Micro API Credentials ────────────────────────────────────────────
# Used in env mode (single shared credential loaded from environment).
# Not required when AUTH_MODE=gateway (credentials are provided per-request via headers).
INGRAMMICRO_CLIENT_ID=your_client_id
INGRAMMICRO_CLIENT_SECRET=your_client_secret
# Your Ingram Micro reseller account number, e.g. "20-222222".
INGRAMMICRO_CUSTOMER_NUMBER=your_customer_number
# Two-character ISO country code for the account, e.g. "US".
INGRAMMICRO_COUNTRY_CODE=US

# HTTP header names that carry the four credentials above in gateway mode.
# The client must send all four headers on every /mcp request.
INGRAMMICRO_CLIENT_ID_HEADER=X-IngramMicro-Client-Id
INGRAMMICRO_CLIENT_SECRET_HEADER=X-IngramMicro-Client-Secret
INGRAMMICRO_CUSTOMER_NUMBER_HEADER=X-IngramMicro-Customer-Number
INGRAMMICRO_COUNTRY_CODE_HEADER=X-IngramMicro-Country-Code

# Identifies this integration to Ingram Micro (IM-SenderID header). Not
# tenant-specific credential material, so it's a fixed setting.
INGRAMMICRO_SENDER_ID=MSPbots

# Base URL — swap to Ingram Micro's sandbox host for testing before
# pointing at production. See README for the exact sandbox URL (unverified
# at build time — Ingram's own docs and OpenAPI spec disagree on it).
INGRAMMICRO_BASE_URL=https://api.ingrammicro.com

# ─── IM Cloud / CloudBlue Marketplace API Credentials (PRD-21595) ────────────
# A separate Ingram Micro product (Cloud Marketplace subscriptions, e.g.
# Microsoft 365 plans) from the Resellers API above — different auth,
# different base URL, different credential material.
# Used in env mode only; not required when AUTH_MODE=gateway.
INGRAMMICRO_CLOUD_API_KEY=your_cloud_api_key
INGRAMMICRO_CLOUD_CUSTOMER_ID=your_cloud_customer_id

# HTTP header names that carry the two credentials above in gateway mode.
INGRAMMICRO_CLOUD_API_KEY_HEADER=X-IngramMicroCloud-Api-Key
INGRAMMICRO_CLOUD_CUSTOMER_ID_HEADER=X-IngramMicroCloud-Customer-Id

# No default — see README Known Gaps: the exact IM Cloud API host is
# unverified against Ingram's own deployment. Must be set for
# ingrammicro_cloud_list_subscriptions / ingrammicro_cloud_get_subscription
# to work in env mode. In gateway mode a caller can also override this
# per request via the X-IngramMicroCloud-Base-Url header (PRD-21596).
INGRAMMICRO_CLOUD_BASE_URL=
INGRAMMICRO_CLOUD_BASE_URL_HEADER=X-IngramMicroCloud-Base-Url

# ─── IM Cloud Marketplace Products API Credentials (PRD-21597) ───────────────
# A third, independent credential bundle within the same IM Cloud /
# CloudBlue Marketplace product line as the two settings above — Basic ->
# POST /token -> Bearer + X-Subscription-Key auth, verified against
# Ingram's own published PDF (see README Known Gaps). No customer/tenant
# id: /products is a vendor-scoped catalog, not customer-scoped.
# Used in env mode only; not required when AUTH_MODE=gateway.
INGRAMMICRO_CLOUD_PRODUCTS_CLIENT_ID=your_cloud_products_client_id
INGRAMMICRO_CLOUD_PRODUCTS_CLIENT_SECRET=your_cloud_products_client_secret
INGRAMMICRO_CLOUD_PRODUCTS_MARKETPLACE=us
INGRAMMICRO_CLOUD_PRODUCTS_SUBSCRIPTION_KEY=your_cloud_products_subscription_key

# HTTP header names that carry the five credentials above in gateway mode.
INGRAMMICRO_CLOUD_PRODUCTS_CLIENT_ID_HEADER=X-IngramMicroCloud-Products-Client-Id
INGRAMMICRO_CLOUD_PRODUCTS_CLIENT_SECRET_HEADER=X-IngramMicroCloud-Products-Client-Secret
INGRAMMICRO_CLOUD_PRODUCTS_MARKETPLACE_HEADER=X-IngramMicroCloud-Products-Marketplace
INGRAMMICRO_CLOUD_PRODUCTS_SUBSCRIPTION_KEY_HEADER=X-IngramMicroCloud-Products-Subscription-Key
INGRAMMICRO_CLOUD_PRODUCTS_BASE_URL_HEADER=X-IngramMicroCloud-Products-Base-Url

# No default — not a public constant, handed out per-reseller at
# onboarding (see README Known Gaps). Must be set for
# ingrammicro_cloud_list_products to work in env mode.
INGRAMMICRO_CLOUD_PRODUCTS_BASE_URL=

# ─── MCP Transport ───────────────────────────────────────────────────────────
# "http"  — stateless HTTP server (required for production / multi-tenant use)
# "stdio" — local stdio transport (useful for development / CLI use)
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ─── Auth Mode ───────────────────────────────────────────────────────────────
# "gateway" — (default, SOP-compliant) credentials provided per-request via HTTP headers
#             Required for production / multi-tenant deployments (e.g. behind mcp-gateway).
# "env"     — (local dev only) single credential set loaded from env vars above
#             NOT SOP-compliant: credentials are shared across all requests; do not use in production.
AUTH_MODE=gateway
